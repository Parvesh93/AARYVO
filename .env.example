# Core
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/aaryvo"
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
ADMIN_EMAILS="founder@your-domain.com"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_QUALIFIER_MODEL="gpt-5.6-luna"

# Email notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AARYVO <notifications@your-domain.com>"
NOTIFICATION_EMAIL=""

# Dedicated Aaryvo platform/outreach SMTP (recommended)
PLATFORM_SMTP_HOST=""
PLATFORM_SMTP_PORT="465"
PLATFORM_SMTP_SECURE="true"
PLATFORM_SMTP_USER="aaryvo@ppdesigntech.com"
PLATFORM_SMTP_PASS=""
PLATFORM_SMTP_FROM="Aaryvo <aaryvo@ppdesigntech.com>"
# Server-to-server auth for the Aaryvo sales/outreach agent
OUTREACH_AGENT_SECRET="replace-with-a-long-random-secret"
OUTREACH_SHEET_ID=""
OUTREACH_SHEET_NAME="Leads"

# Razorpay subscriptions
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_STARTER=""
RAZORPAY_PLAN_GROWTH=""
RAZORPAY_PLAN_PRO=""

# Billing / GST
# Current advertised plan prices are treated as GST-inclusive.
BILLING_GST_RATE="18"
# Use the state from PP DESIGN AND TECH's GST registration, e.g. Delhi.
BILLING_SUPPLIER_STATE=""

# Google OAuth calendar integration
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
INTEGRATION_ENCRYPTION_KEY="replace-with-a-long-random-encryption-key"

# Optional legacy/service-account calendar integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID=""
